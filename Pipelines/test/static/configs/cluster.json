{
  "kmeans": {
    "type": "cluster",
    "inputs": ["TEMP", "PRES", "Iws"],
    "weights": "Iws",
    "output": "cluster",
    "method": {
      "type": "kmeans",
      "dissimilarity": { "type": "sqeuclidean" },
      "classes": 3,
      "iterations": 100,
      "tol": 1e-6,
      "seed": 1234,
      "init": "kmpp"
    }
  },
  "kmeansCityblock": {
    "type": "cluster",
    "inputs": ["TEMP", "PRES"],
    "output": "cbcluster",
    "method": {
      "type": "kmeans",
      "dissimilarity": { "type": "cityblock" },
      "classes": 3,
      "seed": 1234
    }
  },
  "kmeansWeighted": {
    "type": "cluster",
    "inputs": ["TEMP", "PRES"],
    "output": "wcluster",
    "method": {
      "type": "kmeans",
      "dissimilarity": { "type": "weighted_cityblock", "weights": [1.0, 0.5] },
      "classes": 3,
      "iterations": 100,
      "tol": 1e-6,
      "seed": 1234,
      "init": "kmpp"
    }
  },
  "dbscanCityblock": {
    "type": "cluster",
    "inputs": ["TEMP", "PRES"],
    "output": "dbcbcluster",
    "method": {
      "type": "dbscan",
      "dissimilarity": { "type": "cityblock" },
      "radius": 0.02
    }
  },
  "dbscan": {
    "type": "cluster",
    "inputs": ["TEMP", "PRES"],
    "output": "dbcluster",
    "method": {
      "type": "dbscan",
      "radius": 0.02
    }
  },
  "affinity": {
    "type": "cluster",
    "inputs": ["TEMP", "PRES"],
    "output": "apcluster",
    "method": {
      "type": "affinity_propagation",
      "damp": 0.5,
      "maxiter": 200,
      "tol": 1e-6
    }
  },
  "hasPartition": {
    "type": "cluster",
    "inputs": ["TEMP", "PRES"],
    "output": "dbcluster",
    "method": {
      "type": "dbscan",
      "radius": 0.02
    },
    "partition": "partition"
  },
  "kmeansInit": {
    "type": "cluster",
    "inputs": ["TEMP", "PRES", "Iws"],
    "weights": "Iws",
    "output": "initcluster",
    "method": {
      "type": "kmeans",
      "dissimilarity": { "type": "sqeuclidean" },
      "classes": 3,
      "iterations": 100,
      "tol": 1e-6,
      "seed": 1234,
      "init": "rand"
    }
  },
  "reconcile": {
    "type": "cluster",
    "inputs": ["x", "y"],
    "output": "cluster",
    "method": {
      "type": "dbscan",
      "radius": 1.0,
      "min_neighbors": 2,
      "min_cluster_size": 3
    }
  },
  "conjunctive": {
    "type": "cluster",
    "inputs": ["x", "y", "z"],
    "output": "cluster",
    "method": {
      "type": "dbscan",
      "radius": 1.0,
      "min_neighbors": 3,
      "min_cluster_size": 3,
      "dissimilarity": {
        "type": "conjunctive",
        "blocks": [1, 1, 2],
        "radii": [5.0, 60.0]
      }
    }
  }
}
